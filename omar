<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>I love you Noor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Amiri:wght@700&display=swap" rel="stylesheet">
<style>
:root{--bg:#050204;--rose:#ff4d6d;--blush:#ffd6e0}
html,body{height:100%;margin:0;background:var(--bg);overflow:hidden}
body{background:radial-gradient(ellipse at 50% 45%,#1a0610 0%,#0a0307 55%,#030102 100%)}
canvas{display:block;width:100%;height:100%;touch-action:none;cursor:pointer}
</style>
<style>
#snd{position:fixed;right:max(14px,env(safe-area-inset-right));bottom:max(14px,env(safe-area-inset-bottom));width:44px;height:44px;border-radius:50%;border:1px solid rgba(255,95,135,.55);background:rgba(20,4,10,.55);color:#ffd6e0;font-size:20px;line-height:1;cursor:pointer;box-shadow:0 0 14px rgba(255,40,100,.35);display:flex;align-items:center;justify-content:center;padding:0}
#snd:focus-visible{outline:2px solid #ff4d6d;outline-offset:3px}
#gate{position:fixed;inset:0;z-index:20;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;cursor:pointer;color:#ffd6e0;font:500 16px Cinzel,serif;letter-spacing:.14em;background:radial-gradient(ellipse at 50% 50%,rgba(5,2,4,.35),rgba(3,1,2,.7));transition:opacity 1.1s ease;text-shadow:0 0 12px rgba(255,60,110,.8)}
#gate .h{font-size:38px;line-height:1;color:#ff1f4b;text-shadow:0 0 22px rgba(255,20,70,.95),0 0 46px rgba(255,20,70,.6)}
#gate .pw{width:min(54vw,34vh,230px);aspect-ratio:1/1;filter:drop-shadow(0 0 16px rgba(255,40,100,.85))}
#gate .pb{position:relative;width:100%;height:100%;background:linear-gradient(135deg,#ff7a99,#ff1f4b);clip-path:url(#hc)}
#gate .pb img{position:absolute;left:5%;top:5%;width:90%;height:90%;object-fit:cover;display:block;clip-path:url(#hc)}
#gate .t{font:700 28px Amiri,"Times New Roman",serif;letter-spacing:0;direction:rtl}
#credit{position:fixed;left:0;right:0;bottom:max(12px,env(safe-area-inset-bottom));z-index:30;text-align:center;pointer-events:none;color:#ffd6e0;font:500 12px Cinzel,"Times New Roman",serif;letter-spacing:.1em;line-height:1.7;opacity:.75;text-shadow:0 0 10px rgba(255,60,110,.8)}
#credit small{display:block;font-size:10px;opacity:.7;letter-spacing:.08em}
#gate.gone{opacity:0;pointer-events:none}
#gate:focus-visible{outline:2px solid #ff4d6d;outline-offset:-8px}
#hint{position:fixed;left:0;right:0;bottom:max(24px,env(safe-area-inset-bottom));text-align:center;color:#ffd6e0;font:500 13px Cinzel,serif;letter-spacing:.08em;opacity:0;transition:opacity .8s;pointer-events:none;text-shadow:0 0 10px rgba(255,60,110,.8)}
#hint.show{opacity:.85}
</style>
</head>
<body>
<canvas id="c" aria-label="A heart drawn from the words I love you, with the name Noor in the middle"></canvas>
<script>
(function(){
var cv=document.getElementById('c'),ctx=cv.getContext('2d');
var W,H,dpr,cx,cy,S,fs,items=[],bg=[],parts=[];
var ptr={x:-999,y:-999,down:false,on:false};
var start=performance.now(),last=start,beat=0,hot=0,lastBurst=0;
var sx=-999,sy=-999,WW=60,CUM=[0],TOT=1;
function tAt(f){var tg=f*TOT,lo=0,hi=CUM.length-1;while(lo<hi){var m=(lo+hi)>>1;if(CUM[m]<tg)lo=m+1;else hi=m}return lo/(CUM.length-1)*Math.PI}
var FONT='Cinzel,"Times New Roman",serif';

function heartPt(t){return{x:16*Math.pow(Math.sin(t),3),y:-(13*Math.cos(t)-5*Math.cos(2*t)-2*Math.cos(3*t)-Math.cos(4*t))}}
function path(ctx,x,y,r){
  ctx.beginPath();ctx.moveTo(x,y-.3*r);
  ctx.bezierCurveTo(x,y-.8*r,x-r,y-.8*r,x-r,y-.2*r);
  ctx.bezierCurveTo(x-r,y+.3*r,x-.4*r,y+.6*r,x,y+r);
  ctx.bezierCurveTo(x+.4*r,y+.6*r,x+r,y+.3*r,x+r,y-.2*r);
  ctx.bezierCurveTo(x+r,y-.8*r,x,y-.8*r,x,y-.3*r);ctx.closePath();
}
function build(){
  items=[];
  ctx.font='700 '+fs+'px '+FONT;var wpx=ctx.measureText('I LOVE YOU').width*1.06,N=6,M=600,cum=[0],prev=heartPt(0),total=0,i,k,side;
  for(i=1;i<=M;i++){var q=heartPt(i/M*Math.PI);total+=Math.hypot(q.x-prev.x,q.y-prev.y);cum.push(total);prev=q}
  CUM=cum;TOT=total;var RC=[12,13],RS=[1,1],SD=[-1,1],rr,mw=1e9;for(rr=0;rr<2;rr++)mw=Math.min(mw,total*S*RS[rr]/RC[rr]);
  wpx=mw;ctx.font='700 100px '+FONT;fs=wpx/1.06/(ctx.measureText('I LOVE YOU').width/100);WW=wpx/1.06;
  for(rr=0;rr<2;rr++){N=RC[rr];var inset=RS[rr];
  for(k=0;k<N;k++){
    var target=(k+.5)/N*total;i=0;while(i<M&&cum[i]<target)i++;
    var t=i/M*Math.PI;
    for(side=SD[rr];side!==0;side=0){
      var tt=side*t,a=heartPt(tt),b=heartPt(tt+.02),c=heartPt(tt-.02);
      var a0=Math.atan2(b.y-c.y,b.x-c.x),pd=side>0?a0:a0+Math.PI,ang=a0;
      if(ang>Math.PI/2)ang-=Math.PI;if(ang<-Math.PI/2)ang+=Math.PI;
      var flip=Math.cos(ang-pd)<0;
      items.push({bx:a.x*inset,by:a.y*inset,ang:ang,ring:0,order:k,frac:(k+.5)/N,k0:k/N,n:N,flip:flip,ox:0,oy:0});
    }
  }
  }
}
function resize(){
  dpr=Math.min(window.devicePixelRatio||1,2);
  W=innerWidth;H=innerHeight;cv.width=W*dpr;cv.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);
  S=Math.min(W*.93/33,H*.66/30);cx=W/2;cy=H*.47;fs=Math.max(10,S*.62);
  build();
  var n=Math.round(Math.min(46,W*H/16000));bg=[];
  for(var i=0;i<n;i++)bg.push({x:Math.random()*W,y:Math.random()*H,r:3+Math.random()*7,v:6+Math.random()*16,ph:Math.random()*6.28,a:.35+Math.random()*.6,hue:Math.random()<.25?28:350+Math.random()*14});
}
function burst(x,y,n){
  for(var i=0;i<n;i++){var a=Math.random()*6.28,sp=40+Math.random()*130;
    parts.push({x:x,y:y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-50,life:1,r:3+Math.random()*6,hue:345+Math.random()*25})}
}
function inHeart(x,y){return Math.abs(x-cx)<S*17&&Math.abs(y-cy)<S*15}
function move(e){var r=cv.getBoundingClientRect();ptr.x=e.clientX-r.left;ptr.y=e.clientY-r.top;ptr.on=true;
  var now=performance.now();
  if(inHeart(ptr.x,ptr.y)&&now-lastBurst>90){lastBurst=now;burst(ptr.x,ptr.y,2)}}
cv.addEventListener('pointermove',move);
cv.addEventListener('pointerdown',function(e){ptr.down=true;move(e);if(inHeart(ptr.x,ptr.y))burst(ptr.x,ptr.y,18)});
addEventListener('pointerup',function(){ptr.down=false});
cv.addEventListener('pointerleave',function(){ptr.on=false;ptr.x=ptr.y=-999});
addEventListener('resize',resize);

function frame(now){
  var dt=Math.min(.05,(now-last)/1000);last=now;var el=(now-start)/1000;
  ctx.clearRect(0,0,W,H);
  if(ptr.on){if(sx<-900){sx=ptr.x;sy=ptr.y}sx+=(ptr.x-sx)*Math.min(1,dt*12);sy+=(ptr.y-sy)*Math.min(1,dt*12)}else{sx=-999;sy=-999}
  // floating hearts
  for(var i=0;i<bg.length;i++){var h=bg[i];h.y-=h.v*dt;h.x+=Math.sin(el*.6+h.ph)*8*dt;
    if(h.y<-20){h.y=H+20;h.x=Math.random()*W}
    ctx.save();ctx.globalAlpha=h.a*(.6+.4*Math.sin(el*1.5+h.ph));
    ctx.shadowColor='hsl('+h.hue+',100%,60%)';ctx.shadowBlur=14;ctx.fillStyle='hsl('+h.hue+',90%,'+(h.hue<100?60:68)+'%)';
    path(ctx,h.x,h.y,h.r);ctx.fill();ctx.restore()}
  // heartbeat
  var over=ptr.on&&inHeart(ptr.x,ptr.y);
  hot+=((over||ptr.down?1:0)-hot)*Math.min(1,dt*6);
  beat+=dt*(2.2+hot*3.5);
  var pulse=1;
  var R=S*7;
  ctx.save();ctx.translate(cx,cy);ctx.scale(pulse,pulse);ctx.translate(-cx,-cy);
  var rc=Math.min(1,Math.max(0,(el-.5)/5.8)),pen=(.5-.5*Math.cos(Math.PI*rc)),pr=Math.min(1,pen),ao=el<5.2?.9:Math.max(.22,.9-(el-5.2)*.5);
  if(false){ctx.save();ctx.lineCap='round';ctx.lineJoin='round';ctx.lineWidth=2;ctx.strokeStyle='rgba(255,95,135,'+ao+')';ctx.shadowColor='rgba(255,60,110,.9)';ctx.shadowBlur=14;
    for(var sd=-1;sd<=1;sd+=2){ctx.beginPath();for(var s2=0;s2<=100;s2++){var pt=heartPt(sd*tAt(pr*s2/100));var px=cx+pt.x*S,py=cy+pt.y*S;if(s2===0)ctx.moveTo(px,py);else ctx.lineTo(px,py)}ctx.stroke();
      if(pr<1){var hd=heartPt(sd*tAt(pr));ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(cx+hd.x*S,cy+hd.y*S,3,0,6.283);ctx.fill()}}
    ctx.restore()}
  ctx.font='700 '+fs+'px '+FONT;ctx.textAlign='center';ctx.textBaseline='middle';
  
  for(var j=0;j<items.length;j++){
    var it=items[j],p=Math.min(1,Math.max(0,(pr-it.k0)*it.n));
    if(p<=0)continue;
    var x=cx+it.bx*S,y=cy+it.by*S,dx=0,dy=0,g=0;
    if(ptr.on){var vx=x-sx,vy=y-sy,d=Math.hypot(vx,vy);
      if(d<R){g=1-d/R;g=g*g*(3-2*g);var f=g*S*2.6;dx=vx/(d+.01)*f;dy=vy/(d+.01)*f}}
    var kf=1-Math.exp(-dt*7);it.ox+=(dx-it.ox)*kf;it.oy+=(dy-it.oy)*kf;
    ctx.save();ctx.globalAlpha=1;ctx.translate(x+it.ox,y+it.oy);ctx.rotate(it.ang);
    var sc=1+g*.35;ctx.scale(sc,sc);
    if(p<1){var cl=(WW+10)*p;ctx.beginPath();ctx.rect(it.flip?WW/2+5-cl:-WW/2-5,-fs,cl,fs*2);ctx.clip()}
    var l=60+g*30;
    ctx.shadowColor='rgba(255,60,110,'+(.7+g*.3)+')';ctx.shadowBlur=12+g*14;
    ctx.fillStyle=it.ring?'hsl(8,95%,'+(70+g*20)+'%)':'hsl(345,95%,'+(l+4+g*18)+'%)';
    ctx.fillText('I LOVE YOU',0,0);ctx.restore();
  }
  ctx.restore();
  // centre text
  var tp=Math.min(1,Math.max(0,(el-5.2)/2));
  if(tp>0){
    var e=1-Math.pow(1-tp,3),size=Math.min(S*2.9,W*.11);
    ctx.save();ctx.globalAlpha=e;ctx.translate(cx,cy-S*.2);
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.shadowColor='rgba(255,120,170,.9)';ctx.shadowBlur=26+hot*20;
    ctx.fillStyle='#f6e8ff';ctx.font='700 '+size*.62+'px '+FONT;ctx.fillText('I LOVE YOU',0,-size*.55);
    ctx.font='700 '+size+'px '+FONT;ctx.fillStyle='#ffd6e0';ctx.fillText('Noor',0,size*.35);
    var nw=ctx.measureText('Noor').width,hr=size*.3,hx=nw/2+size*.5,hy=size*.35,gl=18+8*Math.sin(el*2.2)+hot*10;
    ctx.fillStyle='#ff1f4b';ctx.shadowColor='rgba(255,20,70,1)';ctx.shadowBlur=gl;
    for(var hs=-1;hs<=1;hs+=2){path(ctx,hs*hx,hy,hr);ctx.fill();ctx.shadowBlur=gl*.5;ctx.fill();ctx.shadowBlur=gl}
    ctx.restore();
  }
  // burst particles
  for(var q=parts.length-1;q>=0;q--){var a=parts[q];a.life-=dt*.8;if(a.life<=0){parts.splice(q,1);continue}
    a.vy+=90*dt;a.x+=a.vx*dt;a.y+=a.vy*dt;
    ctx.save();ctx.globalAlpha=a.life;ctx.shadowColor='hsl('+a.hue+',100%,60%)';ctx.shadowBlur=12;ctx.fillStyle='hsl('+a.hue+',95%,62%)';
    path(ctx,a.x,a.y,a.r*(.5+a.life*.5));ctx.fill();ctx.restore()}
  requestAnimationFrame(frame);
}
resize();
(document.fonts&&document.fonts.load?document.fonts.load('700 20px Cinzel').catch(function(){}):Promise.resolve()).then(function(){resize();start=performance.now()+1e9;window.addEventListener('noorstart',function(){start=performance.now()});requestAnimationFrame(frame)});
})();
</script>
<div id="gate" role="button" tabindex="0" aria-label="اضغطي للفتح"><svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><clipPath id="hc" clipPathUnits="objectBoundingBox"><path d="M0.5,0.96 C0.1,0.66 0,0.45 0,0.28 C0,0.1 0.14,0 0.28,0 C0.4,0 0.47,0.07 0.5,0.14 C0.53,0.07 0.6,0 0.72,0 C0.86,0 1,0.1 1,0.28 C1,0.45 0.9,0.66 0.5,0.96 Z"/></clipPath></defs></svg><div class="pw"><div class="pb"><img alt="" src="data:image/jpeg;base64,"></div></div><span class="h">&#9829;</span><span class="t" lang="ar" dir="rtl">اضغطي يا روح قلبي</span></div>
<div id="credit">Made by Omar Nassar<small>&copy; 2026 All rights reserved</small></div>
<audio id="bgm" loop preload="auto" src="data:audio/mpeg;base64,"></audio>
<button id="snd" type="button" aria-label="Toggle music">&#9835;</button>
<div id="hint">Tap anywhere for music</div>
<script>
(function(){
var a=document.getElementById('bgm'),b=document.getElementById('snd'),hint=document.getElementById('hint'),want=true;
a.volume=.8;
function ui(){b.style.opacity=a.paused?.55:1;b.innerHTML=a.paused?'&#9835;&#8201;&#215;':'&#9835;'}
function play(){var r=a.play();if(r&&r.then)r.then(function(){hint.classList.remove('show');ui()}).catch(function(){ui()});}
function first(){document.removeEventListener('pointerdown',first);document.removeEventListener('keydown',first);if(want&&a.paused)play()}
document.addEventListener('pointerdown',first);document.addEventListener('keydown',first);
b.addEventListener('pointerdown',function(e){e.stopPropagation();document.removeEventListener('pointerdown',first)});
b.addEventListener('click',function(){if(a.paused){want=true;play()}else{want=false;a.pause();ui()}});
a.addEventListener('pause',ui);a.addEventListener('play',ui);
ui();play();
var g=document.getElementById('gate');
function openGate(){if(g.classList.contains('gone'))return;g.classList.add('gone');want=true;play();window.dispatchEvent(new Event('noorstart'))}
g.addEventListener('click',openGate);g.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();openGate()}});
})();
</script>
</body>
</html>
